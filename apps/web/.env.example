# Copy to .env.local for local development. NEVER commit real values.
# Local demo (fake data, no Azure needed):
FLEET_PROVIDER=demo

# Real data (deployed by infra/main.bicep, which sets these app settings for you):
# FLEET_PROVIDER=azure
# AVD_SUBSCRIPTION_IDS=<comma-separated subscription ids>
# AZURE_CLIENT_ID=<client id of the user-assigned managed identity>   # omit for system-assigned
# ENABLE_WEB_ACTIONS=false        # true lets Operators/Admins drain, restart and deallocate hosts
# WATCHDOG_MODE=Report            # display only; the real setting lives on the Function App
